{
  "name": "@vdm-design-team/caf",
  "version": "0.3.0",
  "description": "CAF Design System — CAF’s brand tokens built on GDL (the General Design Library), and CAF’s React components. CAF keeps its brand ramp, its UI font, its semantic colour values and its components; everything else is inherited from @vdm-design-team/gdl.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/VDM-Design-Team/CAF-design-system.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "tokens",
    "docs"
  ],
  "exports": {
    "./theme.css": "./dist/theme.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.dark.css": "./dist/tokens.dark.css",
    "./typography.desktop.css": "./dist/typography.desktop.css",
    "./tokens.json": "./dist/tokens.json",
    "./tokens.flat.json": "./dist/tokens.flat.json",
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "import:figma": "node scripts/import-figma.mjs",
    "build": "style-dictionary build --config style-dictionary.config.mjs",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "lint:components": "node scripts/lint-hardcoded-values.mjs",
    "check:contract": "gdl-check-contract --light tokens/semantic/color.json --dark tokens/semantic/color.dark.json --core tokens/core/color.json",
    "check:contrast": "node scripts/check-contrast.mjs",
    "lint:changes": "node scripts/lint-changes.mjs",
    "typecheck": "tsc --noEmit",
    "test:stories": "vitest --run --project=storybook",
    "test:static": "node scripts/test-static-stories.mjs",
    "storybook": "npm run build && storybook dev -p ${PORT:-6006}",
    "storybook:build": "npm run build && storybook build",
    "changelog": "node scripts/changelog.mjs",
    "test": "npm run lint:tokens && npm run lint:components && npm run build && npm run check:contract && npm run check:contrast -- --strict && npm run lint:changes && npm run typecheck && npm run test:stories",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vdm-design-team/gdl": "github:VDM-Design-Team/GDL-design-system#semver:^0.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^4.1.12",
    "chromatic": "^18.13.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.3",
    "storybook-addon-pseudo-states": "^10.6.3",
    "style-dictionary": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
